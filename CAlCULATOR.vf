   ADDER_with_BUS_MUSER_CAlCULATOR  XLXI_7 (.A_IN(XLXN_52[7:0]), 
                                           .B_IN(XLXN_54[7:0]), 
                                           .Clear_in(E), 
                                           .Cout(), 
                                           .TOTAL(XLXN_65[7:0]));
   ssubtractor_with_BUS_MUSER_CAlCULATOR  XLXI_8 (.A_IN(XLXN_52[7:0]), 
                                                 .B_IN(XLXN_54[7:0]), 
                                                 .Clear_in(E), 
                                                 .COUT_1(), 
                                                 .TOTAL(XLXN_66[7:0]));
   MULTIPLIER_MUSER_CAlCULATOR  XLXI_9 (.A_IN(XLXN_52[7:0]), 
                                       .B_IN(XLXN_54[7:0]), 
                                       .Clear_IN(E), 
                                       .M(XLXN_67[7:0]));
   DIV_MUSER_CAlCULATOR  XLXI_10 (.A(XLXN_39[7:0]), 
                                 .B(XLXN_41[7:0]), 
                                 .E(E), 
                                 .S0(S0), 
                                 .S1(S1), 
