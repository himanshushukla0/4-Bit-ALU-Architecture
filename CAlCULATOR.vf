                               .Q(XLXN_7[7:0]), 
                               .Q1(Q1[7:0]));
   COMPLIMENT_8_BIT_MUSER_CAlCULATOR  XLXI_6 (.A(XLXN_4[7:0]), 
                                             .clr(CLR), 
                                             .S(XLXN_3[7:0]));
